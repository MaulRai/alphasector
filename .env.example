# ==============================================================================
# ALPHASECTOR — CONSOLIDATED ENVIRONMENT CONFIGURATION TEMPLATE
# Sectors Hackathon 2026 — Track 01: AI Agents & Assistants
# ==============================================================================
# Copy this file to:
#   1. backend/.env        (for FastAPI backend runtime)
#   2. frontend/.env.local (for Next.js frontend runtime, NEXT_PUBLIC_* variables)
#
# QUICK START ZERO-CONFIG:
# Even without external services configured, AlphaSector automatically:
# - Falls back to local SQLite (backend/alphasector.db)
# - Seeds demo analyst account (demo@alphasector.id / alphasector123)
# - Operates with offline deterministic synthesis if LLM keys are absent
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE FINANCIAL DATA: SECTORS API (Mandatory for Live Market Telemetry)
# ------------------------------------------------------------------------------
# Obtain your API key from the Sectors Hackathon portal (1,000 free credits)
# or register at https://sectors.app
# Note: You can also leave this blank and use USE_MOCK_DATA=true for offline demo,
# or enter your key dynamically in the frontend Settings page (/settings) via BYOK.
SECTORS_API_KEY=your_sectors_api_key_here

# Cache duration in seconds (default: 86400 = 24 hours).
# Preserves Sectors API credits by caching API responses locally in SQLite/Postgres.
SECTORS_CACHE_TTL_SECONDS=86400

# Offline Mock Data Switch (default: false)
# Set to 'true' to explore AlphaSector with zero credit consumption using verified presets.
USE_MOCK_DATA=false

# ------------------------------------------------------------------------------
# 2. LLM REASONING ENGINE: GROQ API (Mandatory for Agent Synthesis)
# ------------------------------------------------------------------------------
# High-speed LLM inference engine. Free tier keys available at: https://console.groq.com/keys
# AlphaSector supports automatic Round-Robin Rotation and 429 rate limit failover across multiple keys.
GROQ_API_KEY_1=your_groq_api_key_1_here
# GROQ_API_KEY_2=your_groq_api_key_2_here
# GROQ_API_KEY_3=your_groq_api_key_3_here

# Groq LLM Model (default: openai/gpt-oss-120b; alternative: llama-3.3-70b-versatile)
GROQ_MODEL=openai/gpt-oss-120b

# ------------------------------------------------------------------------------
# 3. MULTIMODAL VISION: GOOGLE GEMINI VISION (Optional)
# ------------------------------------------------------------------------------
# Enables vision analysis for uploaded technical charts, broker summaries, and RTI screenshots.
# Obtain free API key at: https://aistudio.google.com/app/apikey
# Supports automatic multi-key rotation (Gemini 2.5 Flash / 1.5 Flash).
GEMINI_API_KEY_1=your_gemini_api_key_1_here
# GEMINI_API_KEY_2=your_gemini_api_key_2_here

# ------------------------------------------------------------------------------
# 4. INSTITUTIONAL NOTION EXPORT: 1-CLICK MEMO SYNC (Optional)
# ------------------------------------------------------------------------------
# Allows 1-click publishing of research dossiers and valuation memos into your Notion workspace.
# 1. Create an internal integration at https://www.notion.so/my-integrations to get your token (secret_... or ntn_...)
# 2. Create a page in Notion, click '...' -> 'Connect to' -> select your integration.
# 3. Copy the 32-character Page ID from the end of the page URL.
# Note: Judges can also enter these credentials dynamically inside the UI export modal!
NOTION_API_KEY=your_notion_integration_token_here
NOTION_PARENT_PAGE_ID=your_notion_32char_page_id_here

# ------------------------------------------------------------------------------
# 5. PERSISTENCE & DATABASE: DUAL-MODE ENGINE (Optional)
# ------------------------------------------------------------------------------
# PostgreSQL connection URI (e.g. Neon Cloud Serverless PostgreSQL).
# IF LEFT EMPTY: AlphaSector automatically falls back to local SQLite (backend/alphasector.db)
# with zero configuration required!
DATABASE_URL=

# ------------------------------------------------------------------------------
# 6. IMAGE STORAGE: CLOUDINARY (Optional)
# ------------------------------------------------------------------------------
# Optional remote CDN storage for chat chart attachments.
# If omitted, uploaded images are processed directly in-memory by Gemini Vision.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=alphasector/chat_uploads
# Alternatively use single connection URL:
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# ------------------------------------------------------------------------------
# 7. BACKEND SERVER CONFIGURATION
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:3002,http://localhost:8000
JWT_SECRET_KEY=alphasector-secret-key-2026-hackathon-track01

# ------------------------------------------------------------------------------
# 8. FRONTEND (NEXT.JS) CONFIGURATION (Put into frontend/.env.local)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=AlphaSector
NEXT_PUBLIC_APP_TAGLINE=Autonomous Equity Research Agent for IDX
