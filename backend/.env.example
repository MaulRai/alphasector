# Sectors Financial API Key (Required)
SECTORS_API_KEY=your_sectors_api_key_here

# LLM API Key (Google Gemini recommended, or Anthropic/OpenAI)
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Configuration (Optional, for Neon PostgreSQL / persistence)
DATABASE_URL=
