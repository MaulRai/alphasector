# Sectors Financial API Key (Required)
SECTORS_API_KEY=your_sectors_api_key_here

# Groq LLM API Keys (API Key Rotation pattern: GROQ_API_KEY_1, GROQ_API_KEY_2, etc.)
GROQ_API_KEY_1=your_groq_api_key_1_here
GROQ_API_KEY_2=your_groq_api_key_2_here
GROQ_API_KEY_3=your_groq_api_key_3_here

# Groq Model Configuration
GROQ_MODEL=openai/gpt-oss-120b

# Google Gemini Vision API Keys (Multimodal Vision Rotation: GEMINI_API_KEY_1, GEMINI_API_KEY_2, etc.)
GEMINI_API_KEY_1=your_gemini_api_key_1_here
GEMINI_API_KEY_2=your_gemini_api_key_2_here

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Configuration (Optional, for Neon PostgreSQL / persistence)
DATABASE_URL=

# Mock Data Switch (false = live Sectors API queries; true = zero credit consumption with curated mock presets)
USE_MOCK_DATA=false

# Sectors API Database Cache Duration in Seconds (default: 86400 = 24 hours)
SECTORS_CACHE_TTL_SECONDS=86400

# Cloudinary Storage Configuration (Optional - for Chat Image & Chart Uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here
CLOUDINARY_FOLDER=alphasector/chat_uploads
# Alternatively use single connection URL:
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
